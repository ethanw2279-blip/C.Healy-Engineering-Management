# Supabase connection — copy to .env.local and fill in from your Supabase
# project (Project settings → API). Never commit real keys; .env.local is
# gitignored. Set the same two vars in your Vercel project settings.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Emailing GA1 reports to clients (optional) ──────────────────────────────
# Set these (server-side, in Vercel) to enable the "Email reports to client"
# button, which sends a portal link. Without them the button reports that
# email isn't configured; the PDF/CSV register export still works.
# RESEND_API_KEY=re_your_resend_api_key
# GA1_EMAIL_FROM=C.Healy Engineering <reports@your-domain.com>
# Optional: override the portal link base (defaults to the request host).
# PORTAL_BASE_URL=https://your-app.vercel.app
